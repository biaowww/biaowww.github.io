---
import '../styles/global.css';
import journeyData from '../data/journey.json';
import tree from '../data/skilltree.json';
import footprint from '../data/footprint.json';
import works from '../data/works.json';
import links from '../data/links.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const { acts, chapters } = journeyData;
const chapterTitle: Record<string, string> = Object.fromEntries(chapters.map((c: any) => [c.id, c.title]));

// 天赋盘统计
const treeStats = { lit: 0, learning: 0, locked: 0 } as Record<string, number>;
const branchLit: Record<string, number> = {};
const branchAll: Record<string, number> = {};
for (const b of tree.branches) {
  let lit = 0, all = 0;
  for (const sub of b.subs) for (const sk of sub.skills) {
    all += 1; if (sk.state !== 'locked') lit += 1; treeStats[sk.state] += 1;
  }
  branchLit[b.key] = lit; branchAll[b.key] = all;
}
const treeAll = treeStats.lit + treeStats.learning + treeStats.locked;

// ---- 星盘径向布局（服务端算好坐标）----
const CX = 460, CY = 402, R0 = 62, DR = 31;
const SECT: Record<string, [number, number]> = { tech: [218, 322], craft: [98, 202], biz: [338, 442] };
type Node = { x: number; y: number; state: string; name: string; from: string; branch: string; color: string };
const treeNodes: Node[] = [];
const subLabels: Array<{ x: number; y: number; name: string; color: string; anchor: string }> = [];
const spokes: Array<{ x1: number; y1: number; x2: number; y2: number; color: string; litFrac: number }> = [];
const rnd = (v: number) => Math.round(v * 10) / 10;
for (const b of tree.branches) {
  const [a0, a1] = SECT[b.key];
  const n = b.subs.length;
  b.subs.forEach((sub: any, si: number) => {
    const deg = a0 + ((si + 0.5) * (a1 - a0)) / n;
    const rad = (deg * Math.PI) / 180;
    const dx = Math.cos(rad), dy = Math.sin(rad);
    const m = sub.skills.length;
    const rEnd = R0 + (m - 1) * DR;
    let litN = 0;
    sub.skills.forEach((sk: any, ki: number) => {
      const r = R0 + ki * DR;
      treeNodes.push({ x: rnd(CX + r * dx), y: rnd(CY + r * dy), state: sk.state, name: sk.n, from: sk.from ?? '', branch: b.key, color: b.color });
      if (sk.state !== 'locked') litN++;
    });
    spokes.push({ x1: rnd(CX + (R0 - 24) * dx), y1: rnd(CY + (R0 - 24) * dy), x2: rnd(CX + rEnd * dx), y2: rnd(CY + rEnd * dy), color: b.color, litFrac: litN / m });
    const lr = rEnd + 24;
    subLabels.push({ x: rnd(CX + lr * dx), y: rnd(CY + lr * dy), name: sub.name, color: b.color, anchor: dx > 0.25 ? 'start' : dx < -0.25 ? 'end' : 'middle' });
  });
}
const branchAnchor = tree.branches.map((b: any) => {
  const [a0, a1] = SECT[b.key];
  const rad = ((a0 + a1) / 2 * Math.PI) / 180;
  return { name: b.name, color: b.color, x: rnd(CX + (R0 + 4.5 * DR) * Math.cos(rad)), y: rnd(CY + (R0 + 4.5 * DR) * Math.sin(rad)), lit: branchLit[b.key], all: branchAll[b.key] };
});

const chapterIcons: Record<string, string> = {
  chengdu: '🏔', wuhan: '🌲', arizona: '🌵', uber: '🚗', photographer: '📷',
  netease: '📊', quantic: '🤖', insead: '🌍', accenture: '🗡',
  metaarteek: '🕹', offcircle: '🚀', insurance: '🛡',
};
// 开屏身份标签：过去（划掉）/ 当下 —— 分两行
const heroPast = [
  { label: '#运营专员', anchor: 'ch-uber' },
  { label: '#摄影师', anchor: 'ch-photographer' },
  { label: '#数据工程师', anchor: 'ch-netease' },
  { label: '#管理咨询顾问', anchor: 'ch-accenture' },
];
const heroNow = [
  { label: '#游戏开发者', anchor: 'ch-metaarteek' },
  { label: '#创业者', anchor: 'ch-offcircle' },
  { label: '#保险经理人', anchor: 'ch-insurance' },
];
// 情绪曲线：y 越小=越高光。无 id 的点=不加解说的低谷波折（意会不言传，只让线跌下去）
const curvePoints: Array<{ id?: string; y: number; label?: string }> = [
  { id: 'chengdu', y: 8, label: '巅峰' },
  { id: 'wuhan', y: 58 },
  { id: 'arizona', y: 34 },
  { id: 'uber', y: 16 },
  { id: 'photographer', y: 30 },
  { y: 86 },
  { id: 'netease', y: 44 },
  { id: 'quantic', y: 12 },
  { id: 'insead', y: 9 },
  { id: 'accenture', y: 50 },
  { y: 88 },
  { id: 'metaarteek', y: 68 },
  { id: 'offcircle', y: 16, label: 'NOW↗' },
  { id: 'insurance', y: 40 },
];
const stateLabel: Record<string, string> = { lit: '已点亮', learning: '修炼中', locked: '未点亮' };
const W = 820, H = 140, PAD = 40;
const step = (W - PAD * 2) / (curvePoints.length - 1);
const pts = curvePoints.map((p, i) => ({ ...p, x: PAD + i * step }));
// 平滑曲线（Catmull-Rom→贝塞尔），让起伏更顺滑戏剧
const smooth = (a: typeof pts) => {
  let d = `M ${a[0].x} ${a[0].y}`;
  for (let i = 0; i < a.length - 1; i++) {
    const p0 = a[i - 1] || a[i], p1 = a[i], p2 = a[i + 1], p3 = a[i + 2] || a[i + 1];
    const c1x = p1.x + (p2.x - p0.x) / 6, c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6, c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${rnd(c1x)} ${rnd(c1y)} ${rnd(c2x)} ${rnd(c2y)} ${p2.x} ${p2.y}`;
  }
  return d;
};
const pathD = smooth(pts);

const mapRows = footprint.pixelMap;
const mapCols = Math.max(...mapRows.map((r) => r.length));
const continentByKey = Object.fromEntries(footprint.continents.map((c) => [c.key, c]));
const visitedCount = footprint.continents.filter((c) => c.visited).length;
const explorePct = Math.round((visitedCount / 7) * 100);
const chinaPct = Math.round((footprint.china.visited / footprint.china.total) * 100);
const swVar: Record<string, string> = { R: '--green', E: '--blue', N: '--orange', A: '--pink', O: '--teal' };
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BIAO WANG · 白手起家的游戏农民工</title>
    <meta name="description" content="王彪的个人网站：一个经历超杂的游戏农民工的英雄旅程、技能树、世界探索度与创作物品栏。" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fusion-pixel-12px-proportional-zh_hans@2025.5.14/font.min.css"
    />
    <style is:inline set:html={`body{font-family:'fusion-pixel-12px-proportional-zh_hans',ui-monospace,'Microsoft YaHei',monospace}`}></style>
  </head>
  <body>
    <!-- 0 · 标题画面 -->
    <section id="title-screen">
      <h1>BIAO WANG</h1>
      <p class="tagline">白手起家、经历<span class="hl">超杂</span>的<span class="hl">游戏农民工</span></p>
      <div class="tags tags-past">
        {heroPast.map((t) => <a href={`#${t.anchor}`} class="past">{t.label}</a>)}
      </div>
      <div class="tags tags-now">
        {heroNow.map((t) => <a href={`#${t.anchor}`} class="now">{t.label}</a>)}
      </div>
      <button class="press-start" onclick="document.getElementById('intro').scrollIntoView()">
        ▶ PRESS START
      </button>
      <p class="hint">按下开始，读取存档</p>
    </section>

    <!-- intro -->
    <section id="intro">
      <h2 class="sec-title">READ ME</h2>
      <p class="sec-sub">// 开场白，60 秒读完</p>
      <div class="panel">
        <span class="draft-chip">文案草稿 · 待定稿</span>
        <p>我叫<span class="kw">王彪</span>，一个白手起家、经历超杂的游戏农民工。</p>
        <p>两条线贯穿我的履历：作为<span class="kw">第一代数据人</span>，我从给别人提建议的分析师，做成亲手写产品的开发者，如今正把下一步押在一家 <span class="kw">AI-native 游戏公司</span>上；作为游戏人，我的职业生涯几乎与<span class="kw">中国移动游戏的腾飞</span>同频——从流量为王，到《黑神话》式的品质时代，我都在场。</p>
        <p>中间绕过不少路：赴美直博又退学、加州 Uber 做增长、兼职职业摄影师、巴黎 Quantic Dream 顾问、INSEAD、埃森哲军师，2026 年还开了保险经纪这条新支线。绕路让我确认了一件事：<span class="kw">「玩」是人的天性</span>——做出配得上这份天性的游戏，值得当成一生的主线任务。</p>
      </div>
    </section>

    <!-- 1 · 英雄旅程（本站亮点，独立成章） -->
    <section id="journey">
      <h2 class="sec-title">英雄旅程</h2>
      <p class="sec-sub">// 一条命，一路打怪 —— 高开，低走，再爬起来</p>

      <!-- 情绪曲线 -->
      <div class="curve-wrap">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="人生情绪曲线">
          <path d={pathD} fill="none" stroke="var(--orange)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          {pts.map((p) => (
            p.id ? (
              <a href={`#ch-${p.id}`}>
                <circle cx={p.x} cy={p.y} r="6.5" fill="var(--bg-panel)" stroke="var(--ink)" stroke-width="3" />
              </a>
            ) : null
          ))}
          {pts.filter((p) => p.label).map((p) => (
            <text x={p.x} y={p.y - 12} font-size="11" fill="var(--ink-dim)" text-anchor="middle">{p.label}</text>
          ))}
        </svg>
        <p class="curve-note">* 情绪曲线：巅峰在开场第 5 分钟（编剧胆子很大）。圆点可点击跳到那一章。</p>
      </div>

      {acts.map((act) => (
        <>
          <div class="act-banner">{act.banner}</div>
          <p class="act-sub">{act.sub}</p>
          {chapters.filter((c) => c.act === act.key).map((ch) => (
            <div class={`chapter${ch.side ? ' is-side' : ''}`} data-chapter id={`ch-${ch.id}`}>
              <div>
                <div class="node">{chapterIcons[ch.id] ?? '▪'}</div>
                <div class="rail"></div>
              </div>
              <div>
                <div class="chapter-head">
                  <span class={`tag ${ch.side ? 'side' : ''}`}>{ch.chapter}</span>
                  {ch.side && <span class="side-badge">SIDE QUEST</span>}
                  <h3>{ch.title}</h3>
                  <div class="meta">{ch.loc} · {ch.years}</div>
                </div>
                {ch.lines.map((l, i) => (
                  <p class={ch.id === 'chengdu' && i === 0 ? 'peak' : ''}>{l}</p>
                ))}
              </div>
            </div>
          ))}
        </>
      ))}
    </section>

    <!-- 1.5 · 技能星盘（全量天赋盘，独立成章） -->
    <section id="skills">
      <h2 class="sec-title">技能星盘</h2>
      <p class="sec-sub">// 三系十二支 · 点得深的没几支，留白才是常态 —— 悬停任意光点看详情</p>
      <div class="tree-legend2">
        <span class="lg lit">已点亮 {treeStats.lit}</span>
        <span class="lg learning">修炼中 {treeStats.learning}</span>
        <span class="lg locked">未点亮 {treeStats.locked}</span>
        <span class="lg-note">越靠外越进阶，前沿大多没点 —— 有选择地留白，不追求满级</span>
      </div>

      <div class="starmap">
        <svg viewBox="0 0 920 804" role="img" aria-label="技能星盘">
          {spokes.map((s) => (
            <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke={`var(${s.color})`}
              stroke-width="2" stroke-linecap="round" opacity={0.14 + 0.34 * s.litFrac} />
          ))}
          <circle cx={CX} cy={CY} r="30" fill="var(--bg-panel)" stroke="var(--line-dark)" stroke-width="3" />
          <text x={CX} y={CY - 2} text-anchor="middle" font-size="15" fill="var(--ink)">天赋</text>
          <text x={CX} y={CY + 15} text-anchor="middle" font-size="12" fill="var(--ink-dim)">{treeStats.lit}/{treeAll}</text>
          {treeNodes.map((nd) => (
            <circle class={`snode ${nd.state}`} cx={nd.x} cy={nd.y}
              r={nd.state === 'lit' ? 7 : nd.state === 'learning' ? 6 : 4.5}
              fill={nd.state === 'locked' ? 'var(--bg-panel)' : `var(${nd.color})`}
              stroke={`var(${nd.color})`}
              stroke-width={nd.state === 'lit' ? 0 : nd.state === 'learning' ? 2 : 1.5}
              stroke-dasharray={nd.state === 'learning' ? '3 2' : ''}
              opacity={nd.state === 'locked' ? 0.5 : 1}
              data-n={nd.name} data-s={nd.state} data-from={nd.from} data-c={nd.color} />
          ))}
          {subLabels.map((l) => (
            <text x={l.x} y={l.y} fill={`var(${l.color})`} text-anchor={l.anchor}
              dominant-baseline="middle" font-size="12.5" opacity="0.85">{l.name}</text>
          ))}
          {branchAnchor.map((b) => (
            <text x={b.x} y={b.y} fill={`var(${b.color})`} text-anchor="middle" font-size="15" font-weight="bold" opacity="0.9">{b.name}</text>
          ))}
        </svg>
        <div class="star-tip" id="starTip" hidden></div>
      </div>
    </section>

    <!-- 2 · 世界地图 -->
    <section id="map">
      <h2 class="sec-title">世界地图</h2>
      <p class="sec-sub">// WORLD EXPLORED · 悬停查看大洲战报</p>
      <p class="map-stats">探索度 <b>{explorePct}%</b>（{visitedCount} / 7 大洲）</p>
      <div class="map-grid" style={`grid-template-columns: repeat(${mapCols}, 16px);`}>
        {mapRows.flatMap((row) =>
          Array.from({ length: mapCols }, (_, x) => {
            const chLetter = row[x] ?? '.';
            if (chLetter === '.') return <div class="cell"></div>;
            const cont = continentByKey[chLetter];
            const cls = cont?.visited ? `cell land lit-${chLetter}` : 'cell land';
            return <div class={cls} data-cont={chLetter}></div>;
          })
        )}
      </div>
      <div id="map-tip">—</div>
      <div class="legend">
        {footprint.continents.map((c) => (
          <span class={`item ${c.visited ? 'v' : ''}`} data-cont={c.key}>
            <span class="sw" style={c.visited && swVar[c.key] ? `background: var(${swVar[c.key]})` : ''}></span>
            {c.name}{c.visited ? '' : ` · ${c.note}`}
          </span>
        ))}
      </div>
      <div class="china-bar panel">
        <div class="row"><span>中国 · 省级行政区点亮进度</span><b>{footprint.china.visited} / {footprint.china.total}（{chinaPct}%）</b></div>
        <div class="china-track"><div class="china-fill" style={`width:${chinaPct}%`}></div></div>
        <p class="china-note">待解锁关卡：<span class="lock">{footprint.china.remaining.join(' · ')}</span></p>
      </div>
    </section>

    <!-- 3 · 创作物品栏 -->
    <section id="inventory">
      <h2 class="sec-title">创作物品栏</h2>
      <p class="sec-sub">// INVENTORY · 个人创作，与工作室作品严格分账</p>
      <div class="grid">
        {works.map((w) => (
          <div class="slot">
            <span class="icon">{w.icon}</span>
            <div class="kind">{w.kind}</div>
            <h3>{w.name}</h3>
            <p>{w.desc}</p>
            {w.link
              ? <a href={w.link} target="_blank" rel="noopener">{w.linkLabel} →</a>
              : <span class="todo">{w.linkLabel}</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- 4 · 好友列表 -->
    <section id="links">
      <h2 class="sec-title">好友列表</h2>
      <p class="sec-sub">// 在别的服务器找到我</p>
      <ul>
        {links.map((l) => (
          <li>
            <span class={`dot ${l.url ? '' : 'off'}`}></span>
            {l.url ? <a href={l.url} target="_blank" rel="noopener">{l.name}</a> : <span>{l.name}</span>}
            <span class="tag">{l.tag}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>© 2026 BIAO WANG · 本站由像素与执念构成</p>
      <p><span class="c">CONTINUE?</span> — 是的，主线仍在更新。</p>
    </footer>

    <script>
      // 章节滚动点亮（灰→彩淡入，点亮不熄灭）
      const chapterEls = [...document.querySelectorAll('[data-chapter]')];
      const lit = new Set();
      function checkChapters() {
        const vh = window.innerHeight;
        for (const c of chapterEls) {
          if (lit.has(c)) continue;
          if (c.getBoundingClientRect().top < vh * 0.72) { c.classList.add('lit'); lit.add(c); }
        }
      }
      addEventListener('scroll', checkChapters, { passive: true });
      addEventListener('resize', checkChapters);
      checkChapters();

      // 技能星盘：悬停光点看详情（技能名 · 状态 · 习得于哪一章）
      const CHTITLE = JSON.parse(document.getElementById('ch-title').textContent);
      const SLABEL = { lit: '已点亮', learning: '修炼中', locked: '未点亮' };
      const starTip = document.getElementById('starTip');
      const starmap = document.querySelector('.starmap');
      document.querySelectorAll('.snode').forEach((nd) => {
        nd.addEventListener('mouseenter', (e) => {
          const s = nd.dataset.s, from = nd.dataset.from;
          let sub = SLABEL[s];
          if (s !== 'locked' && from && CHTITLE[from]) sub += ' · 习得于「' + CHTITLE[from] + '」';
          else if (s === 'locked') sub += ' · 想补的方向';
          starTip.innerHTML = '<b>' + nd.dataset.n + '</b><br>' + sub;
          starTip.style.setProperty('--c', 'var(' + nd.dataset.c + ')');
          starTip.hidden = false;
        });
        nd.addEventListener('mousemove', (e) => {
          const box = starmap.getBoundingClientRect();
          starTip.style.left = (e.clientX - box.left + 12) + 'px';
          starTip.style.top = (e.clientY - box.top + 12) + 'px';
        });
        nd.addEventListener('mouseleave', () => { starTip.hidden = true; });
      });

      // 地图悬停战报
      const tip = document.getElementById('map-tip');
      const CONT = JSON.parse(document.getElementById('cont-data').textContent);
      document.querySelectorAll('[data-cont]').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          const c = CONT[el.dataset.cont];
          if (!c) return;
          tip.textContent = c.visited
            ? `${c.name} ✅ ${c.places.join(' / ')}`
            : `${c.name} 🔒 ${c.note}`;
        });
      });
    </script>
    <script type="application/json" id="cont-data" set:html={JSON.stringify(continentByKey)}></script>
    <script type="application/json" id="ch-title" set:html={JSON.stringify(chapterTitle)}></script>
  </body>
</html>

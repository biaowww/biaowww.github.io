---
import '../styles/global.css';
import journeyData from '../data/journey.json';
import tree from '../data/skilltree.json';
import footprint from '../data/footprint.json';
import works from '../data/works.json';
import links from '../data/links.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const { acts, chapters } = journeyData;

// 合体/旅程用：把天赋盘上「已点亮/修炼中且有出处」的技能按章节归位
const skillsByChapter: Record<string, Array<{ name: string; branch: string; state: string }>> = {};
const branchTotals: Record<string, number> = { tech: 0, craft: 0, biz: 0 };
for (const b of tree.branches) {
  for (const sub of b.subs) {
    for (const sk of sub.skills) {
      if (sk.from && sk.state !== 'locked') {
        (skillsByChapter[sk.from] ??= []).push({ name: sk.n, branch: b.key, state: sk.state });
        branchTotals[b.key] += 1;
      }
    }
  }
}
const skillTotal = branchTotals.tech + branchTotals.craft + branchTotals.biz;

// 技能树 tab 用：每支的 已点亮/全部 计数 + 全局统计
const branchLit: Record<string, number> = {};
const branchAll: Record<string, number> = {};
const treeStats = { lit: 0, learning: 0, locked: 0 } as Record<string, number>;
for (const b of tree.branches) {
  let lit = 0, all = 0;
  for (const sub of b.subs) for (const sk of sub.skills) {
    all += 1; if (sk.state !== 'locked') lit += 1;
    treeStats[sk.state] += 1;
  }
  branchLit[b.key] = lit; branchAll[b.key] = all;
}
const treeAll = treeStats.lit + treeStats.learning + treeStats.locked;

const chapterIcons: Record<string, string> = {
  chengdu: '🏔', wuhan: '🌲', arizona: '🌵', uber: '🚗', photographer: '📷',
  netease: '📊', quantic: '🤖', insead: '🌍', accenture: '🗡',
  metaarteek: '🕹', offcircle: '🚀', insurance: '🛡',
};
// 开屏标签 → 对应章节锚点（前后呼应）
const heroTags = [
  { label: '#运营专员', anchor: 'ch-uber', state: 'past' },
  { label: '#摄影师', anchor: 'ch-photographer', state: 'past' },
  { label: '#数据工程师', anchor: 'ch-netease', state: 'past' },
  { label: '#管理咨询顾问', anchor: 'ch-accenture', state: 'past' },
  { label: '#游戏开发者', anchor: 'ch-metaarteek', state: 'now' },
  { label: '#创业者', anchor: 'ch-offcircle', state: 'now' },
  { label: '#保险经理人', anchor: 'ch-insurance', state: 'now' },
];
// 剧情曲线：y 越小 = 情绪越高。含两处「章内低谷」标注点（红点、不可点）。← 待王彪补更多高/低点
const curvePoints: Array<{ id?: string; y: number; label?: string }> = [
  { id: 'chengdu', y: 12, label: '巅峰' },
  { id: 'wuhan', y: 54 },
  { id: 'arizona', y: 40 },
  { id: 'uber', y: 24 },
  { id: 'photographer', y: 34 },
  { y: 92, label: '网易头两年·水土不服' },
  { id: 'netease', y: 42 },
  { id: 'quantic', y: 18 },
  { id: 'insead', y: 14 },
  { id: 'accenture', y: 44 },
  { y: 94, label: '埃森哲末期·想跑' },
  { id: 'metaarteek', y: 66 },
  { id: 'offcircle', y: 20, label: 'NOW↗' },
  { id: 'insurance', y: 40 },
];
const W = 820, H = 132, PAD = 40;
const step = (W - PAD * 2) / (curvePoints.length - 1);
const pts = curvePoints.map((p, i) => ({ ...p, x: PAD + i * step }));
const pathD = pts.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');

const mapRows = footprint.pixelMap;
const mapCols = Math.max(...mapRows.map((r) => r.length));
const continentByKey = Object.fromEntries(footprint.continents.map((c) => [c.key, c]));
const visitedCount = footprint.continents.filter((c) => c.visited).length;
const explorePct = Math.round((visitedCount / 7) * 100);
const chinaPct = Math.round((footprint.china.visited / footprint.china.total) * 100);
const swVar: Record<string, string> = { R: '--green', E: '--blue', N: '--orange', A: '--pink', O: '--teal' };
const stateLabel: Record<string, string> = { mastered: '已点亮', training: '修炼中' };
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BIAO WANG · 白手起家的游戏农民工</title>
    <meta name="description" content="王彪的个人网站：一个经历超杂的游戏农民工的英雄旅程、技能树、世界探索度与创作物品栏。" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fusion-pixel-12px-proportional-zh_hans@2025.5.14/font.min.css"
    />
    <style is:inline set:html={`body{font-family:'fusion-pixel-12px-proportional-zh_hans',ui-monospace,'Microsoft YaHei',monospace}`}></style>
  </head>
  <body>
    <!-- 0 · 标题画面 -->
    <section id="title-screen">
      <h1>BIAO WANG</h1>
      <p class="tagline">白手起家、经历<span class="hl">超杂</span>的<span class="hl">游戏农民工</span></p>
      <div class="tags">
        {heroTags.map((t) => <a href={`#${t.anchor}`} class={t.state}>{t.label}</a>)}
      </div>
      <button class="press-start" onclick="document.getElementById('intro').scrollIntoView()">
        ▶ PRESS START
      </button>
      <p class="hint">按下开始，读取存档</p>
    </section>

    <!-- intro -->
    <section id="intro">
      <h2 class="sec-title">READ ME</h2>
      <p class="sec-sub">// 开场白，60 秒读完</p>
      <div class="panel">
        <span class="draft-chip">文案草稿 · 待定稿</span>
        <p>我叫<span class="kw">王彪</span>，一个白手起家、经历超杂的游戏农民工。</p>
        <p>两条线贯穿我的履历：作为<span class="kw">第一代数据人</span>，我从给别人提建议的分析师，做成亲手写产品的开发者，如今正把下一步押在一家 <span class="kw">AI-native 游戏公司</span>上；作为游戏人，我的职业生涯几乎与<span class="kw">中国移动游戏的腾飞</span>同频——从流量为王，到《黑神话》式的品质时代，我都在场。</p>
        <p>中间绕过不少路：赴美直博又退学、加州 Uber 做增长、兼职职业摄影师、巴黎 Quantic Dream 顾问、INSEAD、埃森哲军师，2026 年还开了保险经纪这条新支线。绕路让我确认了一件事：<span class="kw">「玩」是人的天性</span>——做出配得上这份天性的游戏，值得当成一生的主线任务。</p>
      </div>
    </section>

    <!-- 1 · 英雄旅程 · 技能树 -->
    <section id="journey">
      <h2 class="sec-title">英雄旅程 · 技能树</h2>
      <p class="sec-sub">// 一路走来，技能只增不减 —— 三种看法，做完你挑</p>
      <div class="jtabs" id="jtabs">
        <button class="jtab on" data-tab="combo">合体版</button>
        <button class="jtab" data-tab="story">旅程</button>
        <button class="jtab" data-tab="tree">技能树</button>
      </div>

      <!-- 旅程 / 合体 面板 -->
      <div id="journeyPane">
      <div class="xp-wrap">
        <div class="xp-label"><span>技能收集</span><span><b id="xp-num">0</b> / {skillTotal}</span></div>
        <div class="xp-bar"><div class="xp-fill" id="xp-fill"></div></div>
        <div class="sk-breakdown">
          <span class="d">技术 <b id="mTech">0</b>/{branchTotals.tech}</span>
          <span class="c">创作 <b id="mCraft">0</b>/{branchTotals.craft}</span>
          <span class="z">江湖 <b id="mBiz">0</b>/{branchTotals.biz}</span>
        </div>
      </div>

      <!-- 剧情曲线 -->
      <div class="curve-wrap">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="人生剧情曲线">
          <path d={pathD} fill="none" stroke="var(--orange)" stroke-width="4" stroke-linejoin="round" />
          {pts.map((p) => (
            p.id ? (
              <a href={`#ch-${p.id}`}>
                <circle cx={p.x} cy={p.y} r="6.5" fill="var(--bg-panel)" stroke="var(--ink)" stroke-width="3" />
              </a>
            ) : (
              <circle cx={p.x} cy={p.y} r="4.5" fill="var(--red)" />
            )
          ))}
          {pts.filter((p) => p.label).map((p) => (
            <text x={p.x} y={p.y > 60 ? p.y + 15 : p.y - 12} font-size="10.5"
              fill={p.y > 60 ? 'var(--red)' : 'var(--ink-dim)'} text-anchor="middle">{p.label}</text>
          ))}
        </svg>
        <p class="curve-note">* 情绪曲线：巅峰在开场第 5 分钟（编剧胆子很大），红点是两处低谷。节点可点击跳转。</p>
      </div>

      {acts.map((act) => (
        <>
          <div class="act-banner">{act.banner}</div>
          <p class="act-sub">{act.sub}</p>
          {chapters.filter((c) => c.act === act.key).map((ch) => (
            <div class={`chapter${ch.side ? ' is-side' : ''}`} data-chapter id={`ch-${ch.id}`}>
              <div>
                <div class="node">{chapterIcons[ch.id] ?? '▪'}</div>
                <div class="rail"></div>
              </div>
              <div>
                <div class="chapter-head">
                  <span class={`tag ${ch.side ? 'side' : ''}`}>{ch.chapter}</span>
                  {ch.side && <span class="side-badge">SIDE QUEST</span>}
                  <h3>{ch.title}</h3>
                  <div class="meta">{ch.loc} · {ch.years}</div>
                </div>
                {ch.lines.map((l, i) => (
                  <p class={ch.id === 'chengdu' && i === 0 ? 'peak' : ''}>{l}</p>
                ))}
                {skillsByChapter[ch.id]?.length ? (
                  <div class="ch-skills">
                    <span class="lab">▸ 点亮技能</span>
                    {skillsByChapter[ch.id].map((sk) => (
                      <span class={`skpill b-${sk.branch} ${sk.state}`} data-b={sk.branch}>{sk.name}</span>
                    ))}
                  </div>
                ) : null}
                {/* branch keys: tech/craft/biz */}
              </div>
            </div>
          ))}
        </>
      ))}
      </div><!-- /journeyPane -->

      <!-- 技能树 面板（全量天赋盘） -->
      <div id="treePane" hidden>
        <div class="tree-legend2">
          <span class="lg lit">已点亮 {treeStats.lit}</span>
          <span class="lg learning">修炼中 {treeStats.learning}</span>
          <span class="lg locked">未点亮 {treeStats.locked}</span>
          <span class="lg-note">未点亮 = 有选择地留白，标出边界，不追求覆盖全行业</span>
        </div>
        <div class="tree3">
          {tree.branches.map((b) => (
            <div class={`tcol tcol-${b.key}`}>
              <div class="tcol-head">
                <span class="tcol-name">{b.name}</span>
                <span class="tcol-cnt">{branchLit[b.key]} / {branchAll[b.key]}</span>
              </div>
              {b.subs.map((sub) => (
                <div class="tsub">
                  <div class="tsub-name">{sub.name}</div>
                  <div class="tsub-nodes">
                    {sub.skills.map((sk) => (
                      <span class={`tnode ${sk.state}`}>{sk.n}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 2 · 世界地图 -->
    <section id="map">
      <h2 class="sec-title">世界地图</h2>
      <p class="sec-sub">// WORLD EXPLORED · 悬停查看大洲战报</p>
      <p class="map-stats">探索度 <b>{explorePct}%</b>（{visitedCount} / 7 大洲）</p>
      <div class="map-grid" style={`grid-template-columns: repeat(${mapCols}, 16px);`}>
        {mapRows.flatMap((row) =>
          Array.from({ length: mapCols }, (_, x) => {
            const chLetter = row[x] ?? '.';
            if (chLetter === '.') return <div class="cell"></div>;
            const cont = continentByKey[chLetter];
            const cls = cont?.visited ? `cell land lit-${chLetter}` : 'cell land';
            return <div class={cls} data-cont={chLetter}></div>;
          })
        )}
      </div>
      <div id="map-tip">—</div>
      <div class="legend">
        {footprint.continents.map((c) => (
          <span class={`item ${c.visited ? 'v' : ''}`} data-cont={c.key}>
            <span class="sw" style={c.visited && swVar[c.key] ? `background: var(${swVar[c.key]})` : ''}></span>
            {c.name}{c.visited ? '' : ` · ${c.note}`}
          </span>
        ))}
      </div>
      <div class="china-bar panel">
        <div class="row"><span>中国 · 省级行政区点亮进度</span><b>{footprint.china.visited} / {footprint.china.total}（{chinaPct}%）</b></div>
        <div class="china-track"><div class="china-fill" style={`width:${chinaPct}%`}></div></div>
        <p class="china-note">待解锁关卡：<span class="lock">{footprint.china.remaining.join(' · ')}</span></p>
      </div>
    </section>

    <!-- 3 · 创作物品栏 -->
    <section id="inventory">
      <h2 class="sec-title">创作物品栏</h2>
      <p class="sec-sub">// INVENTORY · 个人创作，与工作室作品严格分账</p>
      <div class="grid">
        {works.map((w) => (
          <div class="slot">
            <span class="icon">{w.icon}</span>
            <div class="kind">{w.kind}</div>
            <h3>{w.name}</h3>
            <p>{w.desc}</p>
            {w.link
              ? <a href={w.link} target="_blank" rel="noopener">{w.linkLabel} →</a>
              : <span class="todo">{w.linkLabel}</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- 4 · 好友列表 -->
    <section id="links">
      <h2 class="sec-title">好友列表</h2>
      <p class="sec-sub">// 在别的服务器找到我</p>
      <ul>
        {links.map((l) => (
          <li>
            <span class={`dot ${l.url ? '' : 'off'}`}></span>
            {l.url ? <a href={l.url} target="_blank" rel="noopener">{l.name}</a> : <span>{l.name}</span>}
            <span class="tag">{l.tag}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>© 2026 BIAO WANG · 本站由像素与执念构成</p>
      <p><span class="c">CONTINUE?</span> — 是的，主线仍在更新。</p>
    </footer>

    <script>
      // 章节点亮 → 技能随旅程累积（只增不减，点亮后不熄灭）
      const chapterEls = [...document.querySelectorAll('[data-chapter]')];
      const xpFill = document.getElementById('xp-fill');
      const xpNum = document.getElementById('xp-num');
      const mEl = { tech: document.getElementById('mTech'), craft: document.getElementById('mCraft'), biz: document.getElementById('mBiz') };
      const acc = { tech: 0, craft: 0, biz: 0 };
      const total = chapterEls.reduce((n, c) => n + c.querySelectorAll('.skpill').length, 0);
      const lit = new Set();
      function checkChapters() {
        const vh = window.innerHeight;
        let changed = false;
        for (const c of chapterEls) {
          if (lit.has(c)) continue;
          const r = c.getBoundingClientRect();
          if (r.top < vh * 0.72) {
            c.classList.add('lit');
            lit.add(c);
            c.querySelectorAll('.skpill').forEach((p) => { acc[p.dataset.b] += 1; });
            changed = true;
          }
        }
        if (changed) {
          const got = acc.tech + acc.craft + acc.biz;
          xpFill.style.width = Math.round((got / (total || 1)) * 100) + '%';
          xpNum.textContent = String(got);
          mEl.tech.textContent = String(acc.tech);
          mEl.craft.textContent = String(acc.craft);
          mEl.biz.textContent = String(acc.biz);
        }
      }
      addEventListener('scroll', checkChapters, { passive: true });
      addEventListener('resize', checkChapters);
      checkChapters();

      // 三视图切换：合体 / 旅程 / 技能树
      const jtabs = [...document.querySelectorAll('.jtab')];
      const journeyPane = document.getElementById('journeyPane');
      const treePane = document.getElementById('treePane');
      function setTab(t) {
        jtabs.forEach((b) => b.classList.toggle('on', b.dataset.tab === t));
        const showJourney = t !== 'tree';
        journeyPane.hidden = !showJourney;
        treePane.hidden = t !== 'tree';
        journeyPane.classList.toggle('mode-story', t === 'story'); // 旅程视图：藏起技能药丸与收集条，只看故事
        if (showJourney) checkChapters();
      }
      document.getElementById('jtabs').addEventListener('click', (e) => {
        const b = e.target.closest('.jtab'); if (b) setTab(b.dataset.tab);
      });

      // 地图悬停战报
      const tip = document.getElementById('map-tip');
      const CONT = JSON.parse(document.getElementById('cont-data').textContent);
      document.querySelectorAll('[data-cont]').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          const c = CONT[el.dataset.cont];
          if (!c) return;
          tip.textContent = c.visited
            ? `${c.name} ✅ ${c.places.join(' / ')}`
            : `${c.name} 🔒 ${c.note}`;
        });
      });
    </script>
    <script type="application/json" id="cont-data" set:html={JSON.stringify(continentByKey)}></script>
  </body>
</html>

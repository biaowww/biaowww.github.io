---
import '../styles/global.css';
import journeyData from '../data/journey.json';
import footprint from '../data/footprint.json';
import works from '../data/works.json';
import links from '../data/links.json';

const { acts, chapters } = journeyData;
const chapterIcons: Record<string, string> = {
  chengdu: '🏔', wuhan: '🌲', arizona: '🌵', photographer: '📷',
  netease: '📊', quantic: '🤖', insead: '🌍', accenture: '🗡',
  metaarteek: '🕹', offcircle: '🚀', insurance: '🛡',
};
// 开屏标签 → 对应章节锚点（前后呼应）
const heroTags = [
  { label: '#摄影师', anchor: 'ch-photographer' },
  { label: '#数据工程师', anchor: 'ch-netease' },
  { label: '#运营专员', anchor: 'ch-netease' },
  { label: '#管理咨询顾问', anchor: 'ch-accenture' },
  { label: '#游戏开发者', anchor: 'ch-metaarteek' },
  { label: '#创业者', anchor: 'ch-offcircle' },
  { label: '#保险经理人', anchor: 'ch-insurance' },
];
// 剧情曲线节点：x 均分，y 手工定（低 = 高光时刻）
const curvePoints: Array<[string, number]> = [
  ['chengdu', 16], ['wuhan', 46], ['arizona', 66], ['photographer', 58],
  ['netease', 44], ['quantic', 36], ['insead', 60], ['accenture', 40],
  ['metaarteek', 78], ['offcircle', 28], ['insurance', 38],
];
const W = 800, H = 110, PAD = 30;
const step = (W - PAD * 2) / (curvePoints.length - 1);
const pts = curvePoints.map(([id, y], i) => ({ id, x: PAD + i * step, y }));
const pathD = pts.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');

const mapRows = footprint.pixelMap;
const mapCols = Math.max(...mapRows.map((r) => r.length));
const continentByKey = Object.fromEntries(footprint.continents.map((c) => [c.key, c]));
const visitedCount = footprint.continents.filter((c) => c.visited).length;
const explorePct = Math.round((visitedCount / 7) * 100);
const chinaPct = Math.round((footprint.china.visited / footprint.china.total) * 100);
const swVar: Record<string, string> = { R: '--green', E: '--blue', N: '--orange', A: '--pink', O: '--teal' };
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BIAO WANG · 白手起家的游戏农民工</title>
    <meta name="description" content="王彪的个人网站：一个经历超杂的游戏农民工的英雄旅程、世界探索度与创作物品栏。" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fusion-pixel-12px-proportional-zh_hans@2025.5.14/font.min.css"
    />
    <style>
      body { font-family: 'fusion-pixel-12px-proportional-zh_hans', ui-monospace, 'Microsoft YaHei', monospace; }
    </style>
  </head>
  <body>
    <!-- 0 · 标题画面 -->
    <section id="title-screen">
      <h1>BIAO WANG</h1>
      <p class="tagline">白手起家、经历<span class="hl">超杂</span>的<span class="hl">游戏农民工</span></p>
      <div class="tags">
        {heroTags.map((t) => <a href={`#${t.anchor}`}>{t.label}</a>)}
      </div>
      <button class="press-start" onclick="document.getElementById('intro').scrollIntoView()">
        ▶ PRESS START
      </button>
      <p class="hint">按下开始，读取存档</p>
    </section>

    <!-- intro -->
    <section id="intro">
      <h2 class="sec-title">READ ME</h2>
      <p class="sec-sub">// 开场白，60 秒读完</p>
      <div class="panel">
        <span class="draft-chip">文案草稿 · 待定稿</span>
        <p>我叫<span class="kw">王彪</span>，一个白手起家、经历超杂的游戏农民工。</p>
        <p>两条线贯穿我的履历：作为<span class="kw">第一代数据人</span>，我从给别人提建议的分析师，做成亲手写产品的开发者，如今正把下一步押在一家 <span class="kw">AI-native 游戏公司</span>上；作为游戏人，我的职业生涯几乎与<span class="kw">中国移动游戏的腾飞</span>同频——从流量为王，到《黑神话》式的品质时代，我都在场。</p>
        <p>中间绕过不少路：赴美直博、职业摄影师、巴黎 Quantic Dream 顾问、INSEAD、埃森哲军师，2026 年还开了保险经纪这条新支线。绕路让我确认了一件事：<span class="kw">「玩」是人的天性</span>——做出配得上这份天性的游戏，值得当成一生的主线任务。</p>
      </div>
    </section>

    <!-- 1 · 英雄旅程 -->
    <section id="journey">
      <h2 class="sec-title">英雄旅程</h2>
      <p class="sec-sub">// 三幕剧结构 · 向下滚动点亮章节</p>
      <div class="xp-wrap">
        <div class="xp-label"><span>LIFE XP</span><span id="xp-num">0%</span></div>
        <div class="xp-bar"><div class="xp-fill" id="xp-fill"></div></div>
      </div>

      <!-- 剧情曲线 -->
      <div class="curve-wrap">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="人生剧情曲线">
          <path d={pathD} fill="none" stroke="var(--orange)" stroke-width="4" stroke-linejoin="round" />
          {pts.map((p) => (
            <a href={`#ch-${p.id}`}>
              <circle cx={p.x} cy={p.y} r="7" fill="var(--bg-panel)" stroke="var(--ink)" stroke-width="3" />
            </a>
          ))}
          <text x={pts[0].x - 12} y={pts[0].y - 14} font-size="12" fill="var(--ink-dim)">巅峰</text>
          <text x={pts[8].x - 24} y={pts[8].y + 22} font-size="12" fill="var(--ink-dim)">至暗时刻?</text>
          <text x={pts[9].x - 12} y={pts[9].y - 14} font-size="12" fill="var(--ink-dim)">NOW↗</text>
        </svg>
        <p class="curve-note">* 剧情曲线：巅峰出现在开场第 5 分钟，编剧胆子很大。节点可点击跳转。</p>
      </div>

      {acts.map((act) => (
        <>
          <div class="act-banner">{act.banner}</div>
          <p class="act-sub">{act.sub}</p>
          {chapters.filter((c) => c.act === act.key).map((ch) => (
            <div class="chapter" data-chapter id={`ch-${ch.id}`}>
              <div>
                <div class="node">{chapterIcons[ch.id] ?? '▪'}</div>
                <div class="rail"></div>
              </div>
              <div>
                <div class="chapter-head">
                  <span class={`tag ${ch.chapter.includes('支线') ? 'side' : ''}`}>{ch.chapter}</span>
                  <h3>{ch.title}</h3>
                  <div class="meta">{ch.loc} · {ch.years}</div>
                </div>
                {ch.lines.map((l, i) => (
                  <p class={ch.id === 'chengdu' && i === 0 ? 'peak' : ''}>{l}</p>
                ))}
              </div>
            </div>
          ))}
        </>
      ))}
    </section>

    <!-- 2 · 世界地图 -->
    <section id="map">
      <h2 class="sec-title">世界地图</h2>
      <p class="sec-sub">// WORLD EXPLORED · 悬停查看大洲战报</p>
      <p class="map-stats">探索度 <b>{explorePct}%</b>（{visitedCount} / 7 大洲）</p>
      <div class="map-grid" style={`grid-template-columns: repeat(${mapCols}, 16px);`}>
        {mapRows.flatMap((row) =>
          Array.from({ length: mapCols }, (_, x) => {
            const chLetter = row[x] ?? '.';
            if (chLetter === '.') return <div class="cell"></div>;
            const cont = continentByKey[chLetter];
            const cls = cont?.visited ? `cell land lit-${chLetter}` : 'cell land';
            return <div class={cls} data-cont={chLetter}></div>;
          })
        )}
      </div>
      <div id="map-tip">—</div>
      <div class="legend">
        {footprint.continents.map((c) => (
          <span class={`item ${c.visited ? 'v' : ''}`} data-cont={c.key}>
            <span class="sw" style={c.visited && swVar[c.key] ? `background: var(${swVar[c.key]})` : ''}></span>
            {c.name}{c.visited ? '' : ` · ${c.note}`}
          </span>
        ))}
      </div>
      <div class="china-bar panel">
        <div class="row"><span>中国 · 省级行政区点亮进度</span><b>{footprint.china.visited} / {footprint.china.total}（{chinaPct}%）</b></div>
        <div class="china-track"><div class="china-fill" style={`width:${chinaPct}%`}></div></div>
        <p class="china-note">待解锁关卡：<span class="lock">{footprint.china.remaining.join(' · ')}</span></p>
      </div>
    </section>

    <!-- 3 · 创作物品栏 -->
    <section id="inventory">
      <h2 class="sec-title">创作物品栏</h2>
      <p class="sec-sub">// INVENTORY · 个人创作，与工作室作品严格分账</p>
      <div class="grid">
        {works.map((w) => (
          <div class="slot">
            <span class="icon">{w.icon}</span>
            <div class="kind">{w.kind}</div>
            <h3>{w.name}</h3>
            <p>{w.desc}</p>
            {w.link
              ? <a href={w.link} target="_blank" rel="noopener">{w.linkLabel} →</a>
              : <span class="todo">{w.linkLabel}</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- 4 · 好友列表 -->
    <section id="links">
      <h2 class="sec-title">好友列表</h2>
      <p class="sec-sub">// 在别的服务器找到我</p>
      <ul>
        {links.map((l) => (
          <li>
            <span class={`dot ${l.url ? '' : 'off'}`}></span>
            {l.url ? <a href={l.url} target="_blank" rel="noopener">{l.name}</a> : <span>{l.name}</span>}
            <span class="tag">{l.tag}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer>
      <p>© 2026 BIAO WANG · 本站由像素与执念构成</p>
      <p><span class="c">CONTINUE?</span> — 是的，主线仍在更新。</p>
    </footer>

    <script>
      // 章节点亮 + XP 进度条（滚动计算，点亮后不熄灭）
      const chapterEls = [...document.querySelectorAll('[data-chapter]')];
      const xpFill = document.getElementById('xp-fill');
      const xpNum = document.getElementById('xp-num');
      const lit = new Set();
      function checkChapters() {
        const vh = window.innerHeight;
        for (const c of chapterEls) {
          if (lit.has(c)) continue;
          const r = c.getBoundingClientRect();
          if (r.top < vh * 0.72) {
            c.classList.add('lit');
            lit.add(c);
          }
        }
        const pct = Math.round((lit.size / chapterEls.length) * 100);
        xpFill.style.width = pct + '%';
        xpNum.textContent = pct + '%';
      }
      addEventListener('scroll', checkChapters, { passive: true });
      addEventListener('resize', checkChapters);
      checkChapters();

      // 地图悬停战报
      const tip = document.getElementById('map-tip');
      const CONT = JSON.parse(document.getElementById('cont-data').textContent);
      document.querySelectorAll('[data-cont]').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          const c = CONT[el.dataset.cont];
          if (!c) return;
          tip.textContent = c.visited
            ? `${c.name} ✅ ${c.places.join(' / ')}`
            : `${c.name} 🔒 ${c.note}`;
        });
      });
    </script>
    <script type="application/json" id="cont-data" set:html={JSON.stringify(continentByKey)}></script>
  </body>
</html>
